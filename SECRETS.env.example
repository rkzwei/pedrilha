# Copy this file to SECRETS.env and fill in real values.
# SECRETS.env is gitignored and must never be committed.
#
# For Docker Compose: copy to .env (also gitignored) so Docker reads it automatically.
#   Linux/macOS:  cp SECRETS.env .env
#   Windows:      Copy-Item SECRETS.env .env

# ── Movie data sources ────────────────────────────────────────────────────────
# TMDB API key — required for sync (movie discovery and metadata)
# Get one free at https://developer.themoviedb.org
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API key — required for enrich (community ratings and critic scores)
# Get one free (1,000 req/day) at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# ── Admin panel ───────────────────────────────────────────────────────────────
# Optional: protects /api/admin/* endpoints with Bearer token auth.
# Leave unset (or empty) to disable admin auth during local dev.
ADMIN_TOKEN=

# ── Email / Magic link auth (Phase 8) ─────────────────────────────────────────
# Any SMTP provider works. Example uses Hostinger; adjust HOST/PORT for others.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=Gem Finder <noreply@yourdomain.com>

# ── JWT session signing (Phase 8) ─────────────────────────────────────────────
# 32+ random bytes, base64 or hex. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_32_plus_random_bytes

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default — leave unset for local dev and Docker)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional explicit path override (defaults to gem_finder.db in cwd)
DATABASE_URL=

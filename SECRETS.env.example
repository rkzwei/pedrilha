# ── Auth is OPTIONAL ─────────────────────────────────────────────────────────
# Leave JWT_SECRET, SMTP_*, and WEBAUTHN_* unset to run without user accounts.
# The app will work fully for film discovery; watchlist features will be hidden.
# Set all of them to enable magic-link sign-in and watchlist functionality.

# Copy this file to SECRETS.env and fill in real values.
# SECRETS.env is gitignored and must never be committed.
#
# For Docker Compose: copy to .env (also gitignored) so Docker reads it automatically.
#   Linux/macOS:  cp SECRETS.env .env
#   Windows:      Copy-Item SECRETS.env .env

# ── Movie data sources ────────────────────────────────────────────────────────
# TMDB API key — required for sync (movie discovery and metadata)
# Get one free at https://developer.themoviedb.org
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API key — required for enrich (community ratings and critic scores)
# Get one free (1,000 req/day) at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# ── Admin panel ───────────────────────────────────────────────────────────────
# ⚠️  REQUIRED IN PRODUCTION. If empty, all /api/admin/* routes are completely
# unprotected — anyone can trigger sync, enrich, score, and seed operations.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# ── Application URL ───────────────────────────────────────────────────────────
# Public-facing base URL. Used in magic-link emails. MUST be set in production.
# Magic-link emails will contain broken localhost links if this is unset.
APP_URL=https://yourdomain.com

# CORS: comma-separated list of allowed origins. Leave empty to allow all (dev mode).
# In production, set this to your domain(s) to prevent unauthorized API access.
CORS_ORIGINS=https://yourdomain.com

# ── Email / Magic link auth (Phase 8) ─────────────────────────────────────────
# Any SMTP provider works. Example uses Hostinger; adjust HOST/PORT for others.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=Gem Finder <noreply@yourdomain.com>

# ── JWT session signing (Phase 8) ─────────────────────────────────────────────
# 32+ random bytes, base64 or hex. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_32_plus_random_bytes

# ── WebAuthn / Passkeys (Phase 8) ────────────────────────────────────────────
# Used for passkey registration and authentication.
# Local dev: use http://localhost:3000 and localhost
# Production: use your actual origin and domain (no trailing slash, no path)
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default — leave unset for local dev and Docker)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional explicit path override (defaults to gem_finder.db in cwd)
DATABASE_URL=

# ── Frontend serving ──────────────────────────────────────────────────────────
# Set to 1 in production to serve compiled WASM from dist/.
# Leave unset for local dev (trunk serve handles the frontend separately).
SERVE_FRONTEND=1

# Log rotation: never (default, soft launch), daily, hourly. Restart required to apply.
LOG_ROTATION=never
